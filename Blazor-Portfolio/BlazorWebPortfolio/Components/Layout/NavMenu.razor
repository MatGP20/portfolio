        <div class="brand">
            
            <a class="navbar-brand" href="/"> <img src="img/MGPLogo.png" alt="MGP Portfolio Logo" class="portfLogo" /> @(pageTittle)</a>
        </div>
    </div>
    <div class="col-md-9 m-0">
